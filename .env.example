# rexcheck Environment Configuration
# Copy this file to .env and fill in the values

# Database
DATABASE_HOST=localhost
DATABASE_USERNAME=postgres
DATABASE_PASSWORD=postgres

# Redis
REDIS_URL=redis://localhost:6379/0

# Rails
SECRET_KEY_BASE=change_this_to_a_real_secret_key_in_production
RAILS_ENV=development
RAILS_MAX_THREADS=5

# Python Worker
POLL_INTERVAL=30
NETWORKS=eth,solana,base,arbitrum,polygon_pos,bsc,avalanche,optimism
GECKO_API_BASE_URL=https://api.geckoterminal.com/api/v2

# DexGuard ML (Rails loads lib/ml_models/xgboost_model.json when xgb gem runs)
DEXGUARD_USE_HEURISTIC_SCORE=false

# AWS (for production S3 storage)
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_REGION=us-east-1
# AWS_S3_BUCKET=rexcheck-storage
