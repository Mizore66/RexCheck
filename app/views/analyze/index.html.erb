<div id="analyze" data-controller="dashboard">
  <!-- Header -->
  <div class="mb-8">
    <h2 class="text-2xl font-bold text-slate-100 tracking-tight">Token Analysis</h2>
    <p class="text-sm text-slate-400 mt-1">Query any token symbol to see aggregated pool health across all networks</p>
  </div>

  <!-- Search Bar -->
  <%= form_with url: analyze_path, method: :get, local: true, class: "mb-8" do |f| %>
    <div class="flex gap-3 items-center">
      <div class="relative flex-1 max-w-md">
        <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none">
          <svg class="w-4 h-4 text-slate-500" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-5.197-5.197m0 0A7.5 7.5 0 105.196 5.196a7.5 7.5 0 0010.607 10.607z" />
          </svg>
        </div>
        <%= f.text_field :symbol,
            value: params[:symbol],
            placeholder: "e.g. ETH, SOL, USDC, WBTC",
            autocomplete: "off",
            class: "w-full bg-slate-900 border border-slate-700 rounded-lg py-2.5 pl-9 pr-4 text-sm font-mono text-slate-200 placeholder-slate-600 focus:outline-none focus:border-emerald-500 focus:ring-1 focus:ring-emerald-500/50 transition-colors" %>
      </div>
      <%= f.submit "Analyze",
          class: "px-5 py-2.5 bg-emerald-600 hover:bg-emerald-500 text-white text-sm font-semibold rounded-lg transition-colors duration-200 cursor-pointer" %>
    </div>

    <% if @available_tokens.any? %>
      <div class="mt-3 flex flex-wrap gap-1.5 items-center">
        <span class="text-xs text-slate-600 font-mono mr-1">Quick:</span>
        <% @available_tokens.each do |token| %>
          <a href="<%= analyze_path(symbol: token) %>"
             class="px-2 py-0.5 text-[11px] font-mono rounded border border-slate-700 text-slate-400 hover:border-emerald-700 hover:text-emerald-400 transition-colors <%= params[:symbol]&.upcase == token ? 'border-emerald-700 text-emerald-400 bg-emerald-900/20' : 'bg-slate-900' %>">
            <%= token %>
          </a>
        <% end %>
      </div>
    <% end %>
  <% end %>

  <% if @result %>
    <%
      status = @result[:overall_status]
      score  = @result[:avg_health_score]

      score_color = case status
      when "SAFE"    then "text-emerald-400"
      when "WARNING" then "text-amber-400"
      when "DANGER"  then "text-rose-500"
      else "text-slate-400"
      end

      badge_classes = case status
      when "SAFE"    then "bg-emerald-900/30 border-emerald-700 text-emerald-400"
      when "WARNING" then "bg-amber-900/30 border-amber-700 text-amber-400"
      when "DANGER"  then "bg-rose-900/30 border-rose-700 text-rose-500"
      else "bg-slate-800 border-slate-700 text-slate-400"
      end

      card_border = case status
      when "SAFE"    then "border-emerald-800/50"
      when "WARNING" then "border-amber-800/50"
      when "DANGER"  then "border-rose-800/50"
      else "border-slate-800"
      end
    %>

    <!-- Summary Card -->
    <div class="bg-slate-900 border <%= card_border %> rounded-xl p-6 mb-6">
      <div class="flex items-start justify-between gap-6">
        <div class="flex-1">
          <div class="flex items-center gap-3 mb-3">
            <h3 class="text-3xl font-bold font-mono text-slate-100"><%= @result[:symbol] %></h3>
            <span class="px-2.5 py-1 text-xs font-bold uppercase rounded border <%= badge_classes %>"><%= status %></span>
          </div>
          <p class="text-sm text-slate-400 mb-4">
            Found across <span class="text-slate-200 font-medium"><%= @result[:pool_count] %> pool<%= @result[:pool_count] == 1 ? "" : "s" %></span>
            on <span class="text-slate-200 font-medium"><%= @result[:networks].join(", ") %></span>
          </p>
          <div class="inline-flex items-center gap-2 px-3 py-2 bg-slate-800/50 rounded-lg border border-slate-700/50 w-fit">
            <svg class="w-4 h-4 text-slate-400" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
            </svg>
            <span class="text-sm font-mono text-slate-300"><%= @result[:recommendation].gsub("_", " ") %></span>
          </div>
        </div>

        <!-- Big Score -->
        <div class="text-right">
          <p class="text-[10px] text-slate-500 uppercase tracking-wider mb-1 font-mono">Avg Health Score</p>
          <p class="text-7xl font-bold font-mono tabular-nums <%= score_color %>"><%= score %></p>
          <p class="text-xs text-slate-600 font-mono mt-1">Range: <%= @result[:min_health_score] %>–<%= @result[:max_health_score] %></p>
        </div>
      </div>

      <!-- Flags -->
      <% if @result[:flags].any? %>
        <div class="mt-5 pt-5 border-t border-slate-800/50">
          <p class="text-[10px] text-slate-500 uppercase tracking-wider mb-2 font-mono">Risk Flags</p>
          <div class="flex flex-wrap gap-2">
            <% @result[:flags].each do |flag| %>
              <%
                flag_classes = case flag
                when "critical_low_liquidity"  then "bg-rose-900/20 text-rose-400 border-rose-800/50"
                when "wash_trading_suspected"   then "bg-amber-900/20 text-amber-400 border-amber-800/50"
                when "unseasoned_pool"          then "bg-cyan-900/20 text-cyan-400 border-cyan-800/50"
                else "bg-slate-800/50 text-slate-400 border-slate-700/50"
                end
              %>
              <span class="px-2.5 py-1 text-xs font-mono rounded border <%= flag_classes %>"><%= flag %></span>
            <% end %>
          </div>
        </div>
      <% end %>
    </div>

    <!-- Pool Breakdown -->
    <div class="mb-4 flex items-center justify-between">
      <h4 class="text-sm font-semibold text-slate-300 uppercase tracking-wider">Pool Breakdown</h4>
      <span class="text-xs text-slate-500 font-mono"><%= @result[:pool_count] %> pool<%= @result[:pool_count] == 1 ? "" : "s" %> found</span>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
      <% @result[:pools].each do |pool| %>
        <%
          ps = pool[:status]
          ps_badge = case ps
          when "SAFE"    then "bg-emerald-900/30 border-emerald-800 text-emerald-400"
          when "WARNING" then "bg-amber-900/30 border-amber-800 text-amber-400"
          when "DANGER"  then "bg-rose-900/30 border-rose-800 text-rose-500"
          else "bg-slate-800 border-slate-700 text-slate-500"
          end

          ps_score_color = case ps
          when "SAFE"    then "text-emerald-400"
          when "WARNING" then "text-amber-400"
          when "DANGER"  then "text-rose-500"
          else "text-slate-500"
          end

          ps_border = case ps
          when "SAFE"    then "border-emerald-800/50 hover:border-emerald-700"
          when "WARNING" then "border-amber-800/50 hover:border-amber-700"
          when "DANGER"  then "border-rose-800/50 hover:border-rose-700"
          else "border-slate-800 hover:border-slate-700"
          end
        %>
        <div class="bg-slate-900 border <%= ps_border %> rounded-xl p-5 transition-all duration-300">
          <div class="flex items-center justify-between mb-4">
            <div class="flex items-center gap-2">
              <span class="px-2 py-0.5 text-[10px] font-bold uppercase rounded border <%= ps_badge %>"><%= ps %></span>
              <span class="text-xs text-slate-500 font-mono"><%= pool[:network].upcase %></span>
            </div>
            <span class="text-4xl font-bold font-mono tabular-nums <%= ps_score_color %>"><%= pool[:health_score] %></span>
          </div>

          <div class="mb-3">
            <p class="text-[10px] text-slate-500 uppercase tracking-wider mb-1">Pair</p>
            <p class="font-mono text-sm text-slate-200"><%= pool[:pair] %></p>
          </div>

          <div class="mb-3">
            <p class="text-[10px] text-slate-500 uppercase tracking-wider mb-1">Pool Address</p>
            <p class="font-mono text-xs text-slate-400 truncate"><%= pool[:pool_address] %></p>
          </div>

          <div class="grid grid-cols-2 gap-3 pt-3 border-t border-slate-800/50 mb-3">
            <div>
              <p class="text-[10px] text-slate-500 uppercase tracking-wider mb-1">Volume (24h)</p>
              <p class="font-mono text-sm text-slate-300">$<%= number_with_delimiter(pool[:volume_usd]&.round(0)) %></p>
            </div>
            <div>
              <p class="text-[10px] text-slate-500 uppercase tracking-wider mb-1">Liquidity</p>
              <p class="font-mono text-sm text-slate-300">$<%= number_with_delimiter(pool[:reserve_in_usd]&.round(0)) %></p>
            </div>
          </div>

          <% if pool[:flags].any? %>
            <div class="flex flex-wrap gap-1 pt-2 border-t border-slate-800/50">
              <% pool[:flags].each do |flag| %>
                <%
                  fc = case flag
                  when "critical_low_liquidity"  then "bg-rose-900/20 text-rose-400 border-rose-800/50"
                  when "wash_trading_suspected"   then "bg-amber-900/20 text-amber-400 border-amber-800/50"
                  when "unseasoned_pool"          then "bg-cyan-900/20 text-cyan-400 border-cyan-800/50"
                  else "bg-slate-800/50 text-slate-400 border-slate-700/50"
                  end
                %>
                <span class="px-1.5 py-0.5 text-[10px] font-mono rounded border <%= fc %>"><%= flag %></span>
              <% end %>
            </div>
          <% end %>

          <div class="mt-3 pt-3 border-t border-slate-800/50">
            <p class="text-[10px] text-slate-600 font-mono">Scanned: <%= time_ago_in_words(pool[:scanned_at]) %> ago</p>
          </div>
        </div>
      <% end %>
    </div>

  <% elsif @not_found %>
    <!-- Not Found -->
    <div class="flex flex-col items-center justify-center py-16 text-center">
      <div class="w-16 h-16 rounded-2xl bg-slate-900 border border-slate-800 flex items-center justify-center mb-4">
        <svg class="w-8 h-8 text-slate-700" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" d="M9.879 7.519c1.171-1.025 3.071-1.025 4.242 0 1.172 1.025 1.172 2.687 0 3.712-.203.179-.43.326-.67.442-.745.361-1.45.999-1.45 1.827v.75M21 12a9 9 0 11-18 0 9 9 0 0118 0zm-9 5.25h.008v.008H12v-.008z" />
        </svg>
      </div>
      <h3 class="text-lg font-semibold text-slate-300 mb-2">No pools found for <span class="font-mono text-emerald-400"><%= @not_found %></span></h3>
      <p class="text-sm text-slate-500 max-w-sm">This token isn't tracked yet. Try one of the tokens listed above.</p>
    </div>

  <% else %>
    <!-- Default / Empty State -->
    <div class="flex flex-col items-center justify-center py-20 text-center">
      <div class="w-20 h-20 rounded-2xl bg-slate-900 border border-slate-800 flex items-center justify-center mb-6">
        <svg class="w-10 h-10 text-slate-700" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-5.197-5.197m0 0A7.5 7.5 0 105.196 5.196a7.5 7.5 0 0010.607 10.607z" />
        </svg>
      </div>
      <h3 class="text-lg font-semibold text-slate-400 mb-2">Enter a token symbol to begin</h3>
      <p class="text-sm text-slate-600 max-w-sm">Type a token symbol like <span class="font-mono text-slate-400">ETH</span> or <span class="font-mono text-slate-400">SOL</span> to see its aggregated pool health score, risk flags, and pool breakdown across all networks.</p>
      <div class="mt-6 grid grid-cols-3 gap-3 text-left max-w-lg">
        <div class="bg-slate-900 border border-slate-800 rounded-xl p-4">
          <p class="text-[10px] text-emerald-400 font-mono uppercase tracking-wider mb-1">SAFE</p>
          <p class="text-2xl font-bold font-mono text-emerald-400">80–100</p>
          <p class="text-xs text-slate-500 mt-1">Trade with caution</p>
        </div>
        <div class="bg-slate-900 border border-slate-800 rounded-xl p-4">
          <p class="text-[10px] text-amber-400 font-mono uppercase tracking-wider mb-1">WARNING</p>
          <p class="text-2xl font-bold font-mono text-amber-400">50–79</p>
          <p class="text-xs text-slate-500 mt-1">Monitor closely</p>
        </div>
        <div class="bg-slate-900 border border-slate-800 rounded-xl p-4">
          <p class="text-[10px] text-rose-500 font-mono uppercase tracking-wider mb-1">DANGER</p>
          <p class="text-2xl font-bold font-mono text-rose-500">0–49</p>
          <p class="text-xs text-slate-500 mt-1">Do not trade</p>
        </div>
      </div>
    </div>
  <% end %>
</div>
