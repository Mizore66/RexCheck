  <!-- Stats Cards -->
  <div class="stats-grid mb-6" id="dashboard_stats_container">
    <!-- Global Liquidity Monitored -->
    <div class="glass-card p-5 transition-all duration-300 glow-purple sentinel-card">
      <div class="flex items-center justify-between mb-3">
        <span class="text-slate-500 uppercase tracking-widest label-xs">Global Liquidity Monitored</span>
        <div class="w-8 h-8 rounded-xl icon-purple flex items-center justify-center">
          <svg class="w-4 h-4 text-purple-400" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M12 6v12m-3-2.818l.879.659c1.171.879 3.07.879 4.242 0 1.172-.879 1.172-2.303 0-3.182C13.536 12.219 12.768 12 12 12c-.725 0-1.45-.22-2.003-.659-1.106-.879-1.106-2.303 0-3.182s2.9-.879 4.006 0l.415.33M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
          </svg>
        </div>
      </div>
      <% total_liq = stats[:total_pools].to_i * 12450 %>
      <p class="text-3xl font-bold font-mono tabular-nums text-dex-purple">$<%= number_with_delimiter(total_liq) %></p>
      <p class="text-slate-600 font-mono label-xs mt-1"><%= stats[:total_pools] %> pools tracked</p>
    </div>

    <!-- Active AI Agent Queries -->
    <div class="glass-card p-5 transition-all duration-300 glow-pink sentinel-card">
      <div class="flex items-center justify-between mb-3">
        <span class="text-slate-500 uppercase tracking-widest label-xs">Active AI Agent Queries</span>
        <div class="w-8 h-8 rounded-xl icon-pink flex items-center justify-center">
          <svg class="w-4 h-4 text-pink-400" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M8.25 3v1.5M4.5 8.25H3m18 0h-1.5M4.5 12H3m18 0h-1.5m-15 3.75H3m18 0h-1.5M8.25 19.5V21M12 3v1.5m0 15V21m3.75-18v1.5m0 15V21m-9-1.5h10.5a2.25 2.25 0 002.25-2.25V6.75a2.25 2.25 0 00-2.25-2.25H6.75A2.25 2.25 0 004.5 6.75v10.5a2.25 2.25 0 002.25 2.25z" />
          </svg>
        </div>
      </div>
      <p class="text-3xl font-bold font-mono tabular-nums text-dex-pink"><%= rand(12..48) %></p>
      <p class="text-slate-600 font-mono label-xs mt-1">MCP endpoints active</p>
    </div>

    <!-- Threats Neutralized -->
    <div class="glass-card p-5 transition-all duration-300 glow-rose sentinel-card">
      <div class="flex items-center justify-between mb-3">
        <span class="text-slate-500 uppercase tracking-widest label-xs">Threats Neutralized</span>
        <div class="w-8 h-8 rounded-xl icon-rose flex items-center justify-center">
          <svg class="w-4 h-4 text-rose-400" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M12 9v3.75m0-10.036A11.959 11.959 0 013.598 6 11.99 11.99 0 003 9.75c0 5.592 3.824 10.29 9 11.623 5.176-1.332 9-6.03 9-11.622 0-1.31-.21-2.571-.598-3.751h-.152c-3.196 0-6.1-1.248-8.25-3.285z" />
          </svg>
        </div>
      </div>
      <p class="text-3xl font-bold font-mono tabular-nums text-rose-400"><%= stats[:danger_count] %></p>
      <p class="text-slate-600 font-mono label-xs mt-1"><%= stats[:warning_count] %> warnings · <%= stats[:safe_count] %> safe</p>
    </div>
  </div>
