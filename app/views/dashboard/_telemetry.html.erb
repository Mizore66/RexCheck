<!-- Agent Telemetry Terminal -->
<div class="glass-card p-4 h-full flex flex-col">
  <div class="flex items-center justify-between mb-3">
    <div class="flex items-center gap-2">
      <div class="w-2.5 h-2.5 rounded-full bg-emerald-400 animate-pulse"></div>
      <span class="text-slate-500 uppercase tracking-widest label-xs">Agent Telemetry</span>
    </div>
    <div class="flex gap-1.5">
      <div class="w-2.5 h-2.5 rounded-full dot-red"></div>
      <div class="w-2.5 h-2.5 rounded-full dot-amber"></div>
      <div class="w-2.5 h-2.5 rounded-full dot-green"></div>
    </div>
  </div>

  <%= turbo_stream_from "telemetry_log" %>
  <div id="telemetry_log" class="flex-1 overflow-y-auto font-mono text-slate-500 space-y-1" style="font-size: 11px; max-height: 320px;">
    <p class="text-emerald-400"><span class="text-slate-600">[<%= Time.current.strftime("%H:%M:%S") %>]</span> DexGuard Sentinel v2.0 initialized</p>
    <p><span class="text-slate-600">[<%= Time.current.strftime("%H:%M:%S") %>]</span> <span class="text-dex-purple">MCP</span> → Connecting to ActionCable stream</p>
    <p><span class="text-slate-600">[<%= Time.current.strftime("%H:%M:%S") %>]</span> <span class="text-dex-pink">WORKER</span> → Polling GeckoTerminal /new_pools</p>
    <p><span class="text-slate-600">[<%= Time.current.strftime("%H:%M:%S") %>]</span> <span class="text-emerald-400">OK</span> → Redis queue depth: 0</p>
    <p class="text-slate-600">— awaiting agent queries —</p>
  </div>
</div>
