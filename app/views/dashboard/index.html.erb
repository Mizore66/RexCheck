<div id="dashboard" data-controller="dashboard">
  <!-- Header -->
  <div class="mb-6">
    <div class="flex items-center justify-between">
      <div>
        <h2 class="text-2xl font-bold text-white tracking-tight">DexGuard Command Center</h2>
        <p class="text-sm text-slate-500 mt-1">Real-time threat intelligence across all monitored networks</p>
      </div>
      <div class="flex items-center gap-3">
        <div class="glass-card flex items-center gap-2 px-3 py-1.5" style="border-radius: 12px;">
          <div class="w-2 h-2 bg-emerald-400 rounded-full animate-pulse"></div>
          <span class="text-emerald-400 font-mono label-xs">SENTINEL ACTIVE</span>
        </div>
      </div>
    </div>
  </div>

  <!-- Top Row: Summary Cards (3-col) -->
  <%= turbo_stream_from "dashboard_stats" %>
  <%= render partial: "dashboard/stats", locals: { stats: @stats } %>

  <!-- Center Section: Split Layout -->
  <div class="dashboard-split mb-6">

    <!-- Left: Threat Heatmap (2/3 width) -->
    <div>
      <div class="glass-card p-5 h-full">
        <div class="flex items-center justify-between mb-4">
          <span class="text-slate-500 uppercase tracking-widest label-xs">Real-Time Threat Heatmap</span>
          <div class="flex items-center gap-3 font-mono text-slate-600 label-xxs">
            <span class="flex items-center gap-1"><span class="w-2 h-2 rounded-sm dot-green"></span> Safe</span>
            <span class="flex items-center gap-1"><span class="w-2 h-2 rounded-sm dot-amber"></span> Warning</span>
            <span class="flex items-center gap-1"><span class="w-2 h-2 rounded-sm dot-red"></span> Danger</span>
          </div>
        </div>

        <!-- Heatmap Grid -->
        <div class="heatmap-grid">
          <% @pools.first(60).each do |pool| %>
            <%
              scan = pool.latest_scan
              sc = scan&.health_score || 0
              cell_class = if sc >= 80 then "heatmap-safe"
                           elsif sc >= 50 then "heatmap-warning"
                           else "heatmap-danger"
                           end
            %>
            <div class="heatmap-cell <%= cell_class %> relative">
              <div class="heatmap-tooltip absolute bottom-full left-1/2 transform -translate-x-1/2 mb-2 w-48 p-2 bg-slate-900 border border-slate-700 rounded-lg shadow-xl z-50 pointer-events-none">
                <div class="text-xs font-bold text-white mb-1 truncate"><%= pool.pool_name.presence || "Unknown Pool" %></div>
                <div class="flex justify-between text-xs font-mono">
                  <span class="text-slate-500"><%= pool.network_id.upcase %></span>
                  <span class="<%= cell_class == 'heatmap-safe' ? 'text-emerald-400' : (cell_class == 'heatmap-warning' ? 'text-amber-400' : 'text-rose-400') %> font-bold"><%= sc %></span>
                </div>
              </div>
            </div>
          <% end %>
          <% (60 - [@pools.size, 60].min).times do %>
            <div class="heatmap-cell heatmap-empty"></div>
          <% end %>
        </div>

        <div class="mt-3 flex items-center justify-between font-mono text-slate-600 label-xxs">
          <span>SOL · ETH · BNB · NEAR · POLYGON</span>
          <span>Last cycle: <%= Time.current.strftime("%H:%M:%S") %></span>
        </div>
      </div>
    </div>

    <!-- Right: Telemetry (1/3 width) -->
    <div>
      <%= render partial: "dashboard/telemetry" %>
    </div>
  </div>

    <!-- Left: Live Pool Scanning Table (Full width) -->
    <div class="glass-card overflow-hidden">
      <div class="p-4 border-b border-glass-light">
        <div class="flex items-center justify-between">
          <span class="text-slate-500 uppercase tracking-widest label-xs">Live Pool Scanning</span>
          <span class="font-mono text-slate-600 label-xxs"><%= @pools.size %> pools</span>
        </div>
      </div>

      <%= turbo_stream_from "pools_grid" %>
      <div class="overflow-x-auto">
        <table class="w-full">
          <thead>
            <tr class="border-b border-glass-light">
              <th class="py-2 px-4 text-left text-slate-600 uppercase tracking-widest label-xxs">Pool</th>
              <th class="py-2 px-4 text-left text-slate-600 uppercase tracking-widest label-xxs">Network</th>
              <th class="py-2 px-4 text-right text-slate-600 uppercase tracking-widest label-xxs">Volume (24h)</th>
              <th class="py-2 px-4 text-right text-slate-600 uppercase tracking-widest label-xxs">Liquidity</th>
              <th class="py-2 px-4 text-center text-slate-600 uppercase tracking-widest label-xxs">Score</th>
              <th class="py-2 px-4 text-center text-slate-600 uppercase tracking-widest label-xxs">Status</th>
            </tr>
          </thead>
          <tbody id="pools_container">
            <% if @pools.any? %>
              <% @pools.each do |pool| %>
                <%= render partial: "dashboard/pool_row", locals: { pool: pool, scan: pool.latest_scan } %>
              <% end %>
            <% else %>
              <tr>
                <td colspan="6" class="py-12 text-center">
                  <div class="flex flex-col items-center">
                    <div class="w-2 h-2 bg-emerald-400 rounded-full animate-pulse mb-3"></div>
                    <p class="text-slate-600 font-mono label-xs">Waiting for pool data…</p>
                  </div>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    </div>
</div>
