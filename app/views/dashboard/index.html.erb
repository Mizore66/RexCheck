<div id="dashboard" data-controller="dashboard">
  <!-- Header -->
  <div class="mb-6">
    <div class="flex items-center justify-between">
      <div>
        <h2 class="text-2xl font-bold text-white tracking-tight">DexGuard Command Center</h2>
        <p class="text-sm text-slate-500 mt-1">Real-time threat intelligence across all monitored networks</p>
      </div>
      <div class="flex items-center gap-3">
        <div class="glass-card flex items-center gap-2 px-3 py-1.5" style="border-radius: 12px;">
          <div class="w-2 h-2 bg-emerald-400 rounded-full animate-pulse"></div>
          <span class="text-emerald-400 font-mono label-xs">SENTINEL ACTIVE</span>
        </div>
      </div>
    </div>
  </div>

  <!-- Top Row: Summary Cards (3-col) -->
  <%= turbo_stream_from "dashboard_stats" %>
  <%= render partial: "dashboard/stats", locals: { stats: @stats } %>

  <!-- Center Section: Split Layout -->
  <div class="dashboard-split mb-6">

    <!-- Left: Threat Heatmap (2/3 width) -->
    <div>
      <div class="glass-card p-5 h-full">
        <div class="flex items-center justify-between mb-4">
          <span class="text-slate-500 uppercase tracking-widest label-xs">Real-Time Threat Heatmap</span>
          <div class="flex items-center gap-3 font-mono text-slate-600 label-xxs">
            <span class="flex items-center gap-1"><span class="w-2 h-2 rounded-sm dot-green"></span> Safe</span>
            <span class="flex items-center gap-1"><span class="w-2 h-2 rounded-sm dot-amber"></span> Warning</span>
            <span class="flex items-center gap-1"><span class="w-2 h-2 rounded-sm dot-red"></span> Danger</span>
          </div>
        </div>

        <!-- Heatmap Grid -->
        <div class="heatmap-grid">
          <% @pools.first(60).each do |pool| %>
            <%
              scan = pool.latest_scan
              sc = scan&.health_score || 0
              cell_class = if sc >= 80 then "heatmap-safe"
                           elsif sc >= 50 then "heatmap-warning"
                           else "heatmap-danger"
                           end
            %>
            <div class="heatmap-cell <%= cell_class %> relative">
              <div class="heatmap-tooltip absolute bottom-full left-1/2 transform -translate-x-1/2 mb-2 w-48 p-2 bg-slate-900 border border-slate-700 rounded-lg shadow-xl z-50 pointer-events-none">
                <div class="text-xs font-bold text-white mb-1 truncate"><%= pool.pool_name.presence || "Unknown Pool" %></div>
                <div class="flex justify-between text-xs font-mono">
                  <span class="text-slate-500"><%= pool.network_id.upcase %></span>
                  <span class="<%= cell_class == 'heatmap-safe' ? 'text-emerald-400' : (cell_class == 'heatmap-warning' ? 'text-amber-400' : 'text-rose-400') %> font-bold"><%= sc %></span>
                </div>
              </div>
            </div>
          <% end %>
          <% (60 - [@pools.size, 60].min).times do %>
            <div class="heatmap-cell heatmap-empty"></div>
          <% end %>
        </div>

        <div class="mt-3 flex items-center justify-between font-mono text-slate-600 label-xxs">
          <span>SOL · ETH · BNB · NEAR · POLYGON</span>
          <span>Last cycle: <%= Time.current.strftime("%H:%M:%S") %></span>
        </div>
      </div>
    </div>

    <!-- Right: Telemetry (1/3 width) -->
    <div>
      <%= render partial: "dashboard/telemetry" %>
    </div>
  </div>

  <!-- Pool Explorer Tabs -->
  <div class="glass-card overflow-hidden">
    <div class="p-4 border-b border-glass-light">
      <div class="flex flex-col gap-4 lg:flex-row lg:items-center lg:justify-between">
        <div>
          <span class="text-slate-500 uppercase tracking-widest label-xs">Pool Explorer</span>
          <p class="text-sm text-slate-500 mt-1">Switch between the live risk feed and the most liquid pools by network.</p>
        </div>

        <div class="flex flex-wrap gap-2" role="tablist" aria-label="Pool explorer views">
          <button type="button"
                  class="px-3 py-1.5 rounded-full border border-emerald-800/60 bg-emerald-900/20 text-emerald-300 font-mono label-xs"
                  data-dashboard-target="tab"
                  data-dashboard-tab-param="live"
                  data-action="dashboard#showTab">
            Live Pool Data
          </button>
          <button type="button"
                  class="px-3 py-1.5 rounded-full border border-slate-800 bg-slate-900/60 text-slate-400 font-mono label-xs hover:text-slate-200"
                  data-dashboard-target="tab"
                  data-dashboard-tab-param="popular"
                  data-action="dashboard#showTab">
            Popular Pools
          </button>
          <% @network_tabs.each do |network| %>
            <button type="button"
                    class="px-3 py-1.5 rounded-full border border-slate-800 bg-slate-900/60 text-slate-400 font-mono label-xs hover:text-slate-200"
                    data-dashboard-target="tab"
                    data-dashboard-tab-param="network-<%= network.parameterize %>"
                    data-action="dashboard#showTab">
              <%= network.upcase %>
            </button>
          <% end %>
        </div>
      </div>
    </div>

    <div data-dashboard-target="panel" data-dashboard-panel-id="live">
      <div class="p-4 border-b border-glass-light flex items-center justify-between">
        <div>
          <span class="text-slate-500 uppercase tracking-widest label-xs">Live Pool Data</span>
          <p class="text-xs text-slate-600 mt-1">Newest scans, including high-risk newly discovered pools.</p>
        </div>
        <span class="font-mono text-slate-600 label-xxs"><%= @pools.size %> pools</span>
      </div>
      <%= turbo_stream_from "pools_grid" %>
      <%= render partial: "dashboard/pool_table", locals: { pools: @pools, container_id: "pools_container", empty_message: "Waiting for pool data..." } %>
    </div>

    <div class="hidden" data-dashboard-target="panel" data-dashboard-panel-id="popular">
      <div class="p-4 border-b border-glass-light flex items-center justify-between">
        <div>
          <span class="text-slate-500 uppercase tracking-widest label-xs">Most Popular Pools</span>
          <p class="text-xs text-slate-600 mt-1">Ranked by liquidity first, then 24h volume.</p>
        </div>
        <span class="font-mono text-slate-600 label-xxs"><%= @popular_pools.size %> pools</span>
      </div>
      <%= render partial: "dashboard/pool_table", locals: { pools: @popular_pools, container_id: nil, empty_message: "No popular pools available yet." } %>
    </div>

    <% @network_tabs.each do |network| %>
      <% network_pools = @popular_pools_by_network.fetch(network, []) %>
      <div class="hidden" data-dashboard-target="panel" data-dashboard-panel-id="network-<%= network.parameterize %>">
        <div class="p-4 border-b border-glass-light flex items-center justify-between">
          <div>
            <span class="text-slate-500 uppercase tracking-widest label-xs"><%= network.upcase %> Popular Pools</span>
            <p class="text-xs text-slate-600 mt-1">Most liquid tracked pools on <%= network.humanize %>.</p>
          </div>
          <span class="font-mono text-slate-600 label-xxs"><%= network_pools.size %> pools</span>
        </div>
        <%= render partial: "dashboard/pool_table", locals: { pools: network_pools, container_id: nil, empty_message: "No #{network.upcase} pools available yet." } %>
      </div>
    <% end %>
  </div>
</div>
