<!DOCTYPE html>
<html lang="en" class="dark">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>DexGuard — Pool Intelligence Sentinel</title>
  <meta name="description" content="Real-time DeFi pool health scoring and risk analysis powered by GeckoTerminal data.">

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&family=JetBrains+Mono:wght@400;500;600;700&display=swap" rel="stylesheet">

  <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
  <%= stylesheet_link_tag "dexguard", "data-turbo-track": "reload" %>
  <%= javascript_include_tag "application", "data-turbo-track": "reload", defer: true %>
  <%= csrf_meta_tags %>
  <%= csp_meta_tag %>
  <%= action_cable_meta_tag %>
</head>
<body class="text-slate-200 font-sans antialiased min-h-screen">
  <div class="flex min-h-screen">

    <!-- Left Sidebar Rail -->
    <aside class="sidebar-rail fixed inset-y-0 left-0 z-40 flex flex-col overflow-hidden">
      <!-- Logo -->
      <div class="p-4 flex items-center gap-3 h-16 border-b border-glass">
        <div class="relative flex-shrink-0">
          <div class="w-10 h-10 rounded-2xl logo-gradient flex items-center justify-center">
            <svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75m-3-7.036A11.959 11.959 0 013.598 6 11.99 11.99 0 003 9.749c0 5.592 3.824 10.29 9 11.623 5.176-1.332 9-6.03 9-11.622 0-1.31-.21-2.571-.598-3.751h-.152c-3.196 0-6.1-1.248-8.25-3.285z" />
            </svg>
          </div>
          <div class="absolute -top-0.5 -right-0.5 w-2.5 h-2.5 bg-emerald-400 rounded-full animate-pulse border-2" style="border-color: #050505;"></div>
        </div>
        <div class="logo-text">
          <h1 class="text-lg font-bold text-white tracking-tight">DexGuard</h1>
          <p class="text-slate-500 font-mono label-xs">v2.0.0-sentinel</p>
        </div>
      </div>

      <!-- Nav -->
      <nav class="flex-1 p-3 space-y-1">
        <a href="/" class="flex items-center gap-3 px-3 py-2.5 rounded-xl nav-item-active transition-all duration-200">
          <svg class="w-5 h-5 flex-shrink-0 text-purple-400" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M3.75 6A2.25 2.25 0 016 3.75h2.25A2.25 2.25 0 0110.5 6v2.25a2.25 2.25 0 01-2.25 2.25H6a2.25 2.25 0 01-2.25-2.25V6zM3.75 15.75A2.25 2.25 0 016 13.5h2.25a2.25 2.25 0 012.25 2.25V18a2.25 2.25 0 01-2.25 2.25H6A2.25 2.25 0 013.75 18v-2.25zM13.5 6a2.25 2.25 0 012.25-2.25H18A2.25 2.25 0 0120.25 6v2.25A2.25 2.25 0 0118 10.5h-2.25a2.25 2.25 0 01-2.25-2.25V6zM13.5 15.75a2.25 2.25 0 012.25-2.25H18a2.25 2.25 0 012.25 2.25V18A2.25 2.25 0 0118 20.25h-2.25A2.25 2.25 0 0113.5 18v-2.25z" />
          </svg>
          <span class="text-sm font-medium nav-label">Dashboard</span>
        </a>

        <a href="/api/v1/mcp/pool_status?address=example&network=eth" class="flex items-center gap-3 px-3 py-2.5 rounded-xl text-slate-500 hover:text-slate-200 transition-all duration-200">
          <svg class="w-5 h-5 flex-shrink-0" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M17.25 6.75L22.5 12l-5.25 5.25m-10.5 0L1.5 12l5.25-5.25m7.5-3l-4.5 16.5" /></svg>
          <span class="text-sm font-medium nav-label">Webhooks / MCP</span>
        </a>
      </nav>

      <!-- Footer -->
      <div class="p-3 border-t border-glass">
        <div class="glass-card p-3">
          <div class="flex items-center gap-2">
            <div class="w-2 h-2 bg-emerald-400 rounded-full animate-pulse flex-shrink-0"></div>
            <span class="text-emerald-400 font-mono label-xs footer-text">ONLINE — Polling</span>
          </div>
        </div>
      </div>
    </aside>

    <!-- Main Content -->
    <main class="main-content flex-1 p-6 lg:p-8">
      <%= yield %>
    </main>
  </div>
</body>
</html>
